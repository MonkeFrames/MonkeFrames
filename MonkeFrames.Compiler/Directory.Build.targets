<?xml version="1.0" encoding="utf-8" ?>
<Project>
	<Target Name="EmbedXmlDoc" AfterTargets="PrepareForBuild">
		<ItemGroup>
			<EmbeddedResource Include="$(IntermediateOutputPath)$(AssemblyName).xml" LogicalName="$(AssemblyName).xml" />
		</ItemGroup>
	</Target>

	
	<Target Name="CopyToBuild" AfterTargets="Build">
		<Copy SourceFiles="$(TargetPath)" DestinationFiles="$(SolutionDir)Build\latest\$(MSBuildProjectName).dll"/>
		<Message Text="$(MSBuildProjectName).dll -> Build\latest\$(MSBuildProjectName).dll" Importance="high"/>
	</Target>
</Project>

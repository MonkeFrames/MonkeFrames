<?xml version="1.0" encoding="utf-8" ?>
<Project>
	<!--
		After a build:
		  1. Copies the two MonkeFrames DLLs to Build\latest (and zips them as Build\latest\MonkeFrames.zip)
		  2. Installs them into Gorilla Tag's BepInEx\plugins\MonkeFrames folder.

		ffmpeg.exe is deliberately NOT copied: the copy in Build\Dependencies can be a Git LFS
		placeholder, and copying it would overwrite a working ffmpeg.exe and break MP4 export.
	-->
	<Target Name="CopyFilesToBuild" AfterTargets="Build">
		<ItemGroup>
			<MonkeFramesDlls Include="$(OutputPath)\MonkeFrames.Compiler.dll" />
			<MonkeFramesDlls Include="$(OutputPath)\MonkeFrames.Editor.dll" />
			<MonkeFramesDlls Include="$(DependenciesPath)\ffmpeg\ffmpeg.exe" />
			<MonkeFramesDlls Include="$(DependenciesPath)\Misc\README.txt" />
		</ItemGroup>

		<Copy SourceFiles="@(MonkeFramesDlls)" DestinationFolder="$(SolutionDir)Build\latest"/>
		<Message Text="Copied assemblies to build folder -> Build\latest" Importance="high"/>

		<Copy SourceFiles="@(MonkeFramesDlls)" DestinationFolder="$(GamePath)\BepInEx\plugins\MonkeFrames\" Condition="'$(CI)'!='TRUE'"/>
		<Message Text="MonkeFrames installed to $(GamePath)\BepInEx\plugins\MonkeFrames" Importance="high"/>
	</Target>
</Project>
